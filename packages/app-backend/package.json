{
  "name": "@omce/app-backend",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./server": {
      "types": "./src/main.d.ts",
      "default": "./src/main.js"
    }
  },
  "scripts": {
    "start": "tsx --tsconfig tsconfig.json src/main.ts",
    "start:dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@omce/canonical-db": "0.0.0",
    "@omce/contracts": "0.0.0",
    "@omce/core-logic": "0.0.0",
    "@omce/swisseph-wasm": "0.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
