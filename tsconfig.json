{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lich-viet/core": ["packages/core/src/index.ts"],
      "@lich-viet/core/*": ["packages/core/src/*/index.ts"],
      "@lich-viet/types": ["packages/types/src/index.ts"],
      "@lich-viet/contracts": ["packages/contracts/src/index.ts"],
      "@lich-viet/api-client": ["packages/api-client/src/index.ts"],
      "@lich-viet/core-logic": ["packages/core-logic/src/index.js", "packages/core-logic/src/index.d.ts"],
      "@lich-viet/canonical-db": ["packages/canonical-db/src/index.js", "packages/canonical-db/src/index.d.ts"],
      "@lich-viet/swisseph-wasm": ["packages/swisseph-wasm/src/index.js", "packages/swisseph-wasm/src/index.d.ts"],
      "@lich-viet/app-backend": ["packages/app-backend/src/index.ts", "packages/app-backend/src/index.d.ts"]
    }
  },
  "include": [
    "src",
    "packages/core/src",
    "packages/types/src",
    "packages/contracts/src",
    "packages/api-client/src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
